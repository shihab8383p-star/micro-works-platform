# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/microjob-platform

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Payment Gateway (Add your API keys)
BKASH_API_KEY=your_bkash_api_key
BKASH_API_SECRET=your_bkash_api_secret
NAGAD_API_KEY=your_nagad_api_key
ROCKET_API_KEY=your_rocket_api_key

# Site Configuration
SITE_NAME=MicroJob Platform
SITE_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
